{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		// Named so the editor and tsc agree: left implicit, the TS server has been
		// seen dropping `@types/node` for a file and flagging every `setTimeout`.
		// `mocha` is for src/test-integration, whose tsconfig extends this one.
		"types": ["node", "mocha"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,   /* enable all strict type-checking options */
		/* Additional Checks */
		"noImplicitReturns": true, /* Report error when not all code paths in function return a value. */
		"noFallthroughCasesInSwitch": true, /* Report errors for fallthrough cases in switch statement. */
		"noUnusedParameters": true,  /* Report errors on unused parameters. */
	},
	"exclude": [
		"node_modules",
		"dist",
		"out",
		"docs",
		"src/webview"
	]
}
